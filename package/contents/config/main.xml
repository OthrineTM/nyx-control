<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="panelIcon" type="String"><default>system-shutdown</default></entry>
    <!-- 0 notifications left, 1 system only, 2 notifications right -->
    <entry name="layoutMode" type="Int"><default>0</default></entry>
    <!-- 0 rings, 1 bars, 2 big numbers -->
    <entry name="gaugeStyle" type="Int"><default>0</default></entry>
    <entry name="showGauges" type="Bool"><default>true</default></entry>
    <!-- GPU load and temperature gauges; hidden anyway when no GPU is reported -->
    <entry name="showGpuGauges" type="Bool"><default>true</default></entry>
    <entry name="showSliders" type="Bool"><default>true</default></entry>
    <entry name="showTiles" type="Bool"><default>true</default></entry>
    <entry name="showSession" type="Bool"><default>true</default></entry>
    <entry name="showProfiles" type="Bool"><default>true</default></entry>

    <!-- shared Nyx style (see NyxPresets.js); the default "Theme" look matches Plasma -->
    <entry name="styleShared" type="Bool"><default>true</default></entry>
    <!-- what a click opens: an app's desktop name, a web address or a command; choices separated by ; -->
    <entry name="clickAction" type="String"><default>org.kde.plasma-systemmonitor</default></entry>
    <entry name="stylePreset" type="String"><default>theme</default></entry>
    <entry name="styleTint" type="String"><default></default></entry>
    <entry name="styleOpacity" type="Int"><default>85</default></entry>
    <entry name="styleBorder" type="Int"><default>10</default></entry>
    <entry name="styleBorderAccent" type="Bool"><default>false</default></entry>
    <entry name="styleRadius" type="Int"><default>12</default></entry>
    <entry name="styleSheen" type="Int"><default>0</default></entry>
    <entry name="styleShadow" type="Int"><default>0</default></entry>
    <entry name="styleGlow" type="Int"><default>0</default></entry>
    <entry name="styleTextShadow" type="Int"><default>0</default></entry>
    <entry name="styleText" type="String"><default></default></entry>
    <entry name="styleAccent" type="String"><default></default></entry>
    <entry name="styleFont" type="String"><default></default></entry>
    <!-- style form: cards, spacing, number weight, capital labels, number font, motion -->
    <entry name="styleCard" type="String"><default>filled</default></entry>
    <entry name="styleSpace" type="Int"><default>50</default></entry>
    <entry name="styleWeight" type="Int"><default>70</default></entry>
    <entry name="styleCaps" type="Bool"><default>false</default></entry>
    <entry name="styleNumFont" type="String"><default></default></entry>
    <entry name="styleMotion" type="Int"><default>30</default></entry>
    <!-- text: secondary color ("" = text color), its strength, automatic readability fixes -->
    <entry name="styleSubText" type="String"><default></default></entry>
    <entry name="styleSubStrength" type="Int"><default>70</default></entry>
    <entry name="styleAutoContrast" type="Bool"><default>false</default></entry>
  </group>
</kcfg>
